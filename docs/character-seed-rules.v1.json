{
  "version": "seed-1.0",
  "vocab_version": "vocab-1.0",
  "notes": [
    "씨앗은 rr_state.signals 로만 계산하는 결정론 재서술이며 결론이 아니다(plan §3.2.4).",
    "축 char:philosophy 는 씨앗이 절대 내지 않는다(좌석 전용).",
    "dsl 가 null 인 규칙은 state.py 가 condition 문자열 그대로 코드로 구현한다(정규식·차수 계산 등 §7 DSL 로 표현되지 않는 조건).",
    "scope 'pair' 규칙은 rr_diff.character_seed 에 담긴다."
  ],
  "rules": [
    {"rule": "seed.structure.multi_file", "tag": "char:structure:multi_file_assembly", "scope": "snap",
     "condition": "counts.files >= 2",
     "dsl": {"all": [{"ref": "sig:counts.files", "op": "gte", "value": 2}]},
     "cites": ["sig:counts.files"]},
    {"rule": "seed.structure.thin_stack", "tag": "char:structure:thin_stack", "scope": "snap",
     "condition": "ratios.tied_ratio >= 0.6 AND ratios.thin_ratio >= 0.3",
     "dsl": {"all": [{"ref": "sig:ratios.tied_ratio", "op": "gte", "value": 0.6}, {"ref": "sig:ratios.thin_ratio", "op": "gte", "value": 0.3}]},
     "cites": ["sig:ratios.tied_ratio", "sig:ratios.thin_ratio"]},
    {"rule": "seed.structure.fastener_dense", "tag": "char:structure:fastener_dense", "scope": "snap",
     "condition": "name_norm 이 screw|bolt|nut|rivet|pem 정규식에 맞는 리프 >= 0.10 * counts.leaf",
     "dsl": null, "pattern": "screw|bolt|nut|rivet|pem", "ratio_gte": 0.10,
     "cites": ["sig:counts.leaf", "[p:] <=10"]},
    {"rule": "seed.structure.adhesive_dependent", "tag": "char:structure:adhesive_dependent", "scope": "snap",
     "condition": "name_norm 이 tape|adhesive|glue|psa|oca|ocr|bond 에 맞는 리프 >= 1 AND 그 리프가 끝점인 tied 엣지 >= 0.3 * counts.edges.tied",
     "dsl": null, "pattern": "tape|adhesive|glue|psa|oca|ocr|bond", "tied_ratio_gte": 0.3,
     "cites": ["[e:] <=10"]},
    {"rule": "seed.structure.rigid_frame_load_path", "tag": "char:structure:rigid_frame_load_path", "scope": "snap",
     "condition": "리프 1개의 차수(clearance 제외) >= 0.3 * leaf AND 그 리프 volume 이 top.volume[1..3] 안",
     "dsl": null, "degree_ratio_gte": 0.3, "volume_top_k": 3,
     "cites": ["[p:] 1"]},
    {"rule": "seed.interface.top_interference", "tag": "char:interface:<alias>", "scope": "snap",
     "condition": "top.interference[1..3] 각 엣지. alias 는 rr_iface_alias 별칭이 있으면 그것, 없으면 name_norm_a + '_' + name_norm_b(정렬)",
     "dsl": null, "top_k": 3,
     "cites": ["[e:]"]},
    {"rule": "seed.tolerance.tight", "tag": "char:tolerance:tight", "scope": "snap",
     "condition": "clearance 엣지 중 min_gap <= 0.1 mm 비율 >= 0.3",
     "dsl": null, "gap_lte_mm": 0.1, "ratio_gte": 0.3,
     "cites": ["sig:hist.gap_mm"]},
    {"rule": "seed.tolerance.loose", "tag": "char:tolerance:loose", "scope": "snap",
     "condition": "clearance 엣지 중 min_gap >= 0.3 mm 비율 >= 0.5",
     "dsl": null, "gap_gte_mm": 0.3, "ratio_gte": 0.5,
     "cites": ["sig:hist.gap_mm"]},
    {"rule": "seed.tolerance.moderate", "tag": "char:tolerance:moderate", "scope": "snap",
     "condition": "tight 도 loose 도 아니고 counts.edges.clearance >= 3",
     "dsl": null, "clearance_gte": 3,
     "cites": ["sig:hist.gap_mm"]},
    {"rule": "seed.maturity.auto_iface_high", "tag": "char:maturity:auto_iface_high", "scope": "snap",
     "condition": "ratios.unconfirmed_ratio >= 0.8",
     "dsl": {"all": [{"ref": "sig:ratios.unconfirmed_ratio", "op": "gte", "value": 0.8}]},
     "cites": ["sig:ratios.unconfirmed_ratio"]},
    {"rule": "seed.maturity.confirmed", "tag": "char:maturity:confirmed", "scope": "snap",
     "condition": "ratios.unconfirmed_ratio <= 0.2 AND edges >= 5",
     "dsl": {"all": [{"ref": "sig:ratios.unconfirmed_ratio", "op": "lte", "value": 0.2}, {"ref": "sig:counts.edges.total", "op": "gte", "value": 5}]},
     "cites": ["sig:ratios.unconfirmed_ratio"]},
    {"rule": "seed.maturity.anon_names_high", "tag": "char:maturity:anon_names_high", "scope": "snap",
     "condition": "G1 fail",
     "dsl": {"all": [{"ref": "gate:G1.pass", "op": "eq", "value": false}]},
     "cites": ["gate:G1"]},
    {"rule": "seed.analysis.no_dyna", "tag": "char:analysis:no_dyna", "scope": "snap",
     "condition": "missing.dyna_absent",
     "dsl": {"all": [{"ref": "missing.dyna_absent", "op": "eq", "value": true}]},
     "cites": []},
    {"rule": "seed.analysis.dyna_structure_only", "tag": "char:analysis:dyna_structure_only", "scope": "snap",
     "condition": "dyna 있고 (dyna_result_absent OR result_kind_mismatch)",
     "dsl": {"all": [{"ref": "missing.dyna_absent", "op": "eq", "value": false}], "any": [{"ref": "missing.dyna_result_absent", "op": "eq", "value": true}, {"ref": "missing.result_kind_mismatch", "op": "eq", "value": true}]},
     "cites": []},
    {"rule": "seed.analysis.dyna_with_results", "tag": "char:analysis:dyna_with_results", "scope": "snap",
     "condition": "dyna 있고 dyna_result 있고 result_kind_mismatch 아님",
     "dsl": {"all": [{"ref": "missing.dyna_absent", "op": "eq", "value": false}, {"ref": "missing.dyna_result_absent", "op": "eq", "value": false}, {"ref": "missing.result_kind_mismatch", "op": "eq", "value": false}]},
     "cites": []},
    {"rule": "seed.change_style.mode", "tag": "char:change_style:<v>", "scope": "pair",
     "condition": "rr_diff 의미 이벤트 change_kind 최빈값 → dimension→dimension_tuning, topology→topology_change, material→material_swap, placement→placement_shift",
     "dsl": null,
     "map": {"dimension": "dimension_tuning", "topology": "topology_change", "material": "material_swap", "placement": "placement_shift"},
     "cites": ["[c:] 최빈 change_kind 상위 3"]}
  ]
}
